library(knitr)
library(scales)
library(ranger)
df <- read.csv("games_march2025_cleaned.csv")
#names(df)
df <- df %>%
mutate(across(where(is.numeric), ~ ifelse(. == -1, NA, .)),
across(where(is.character), ~ ifelse(. == "[]" | . == "", NA, .)))
full_filtered_df <- df %>%
select(appid, name, required_age, release_date, price, windows, mac, linux, recommendations, positive, negative, estimated_owners, discount, tags, pct_pos_total)
# Now, with the full list preped
#we can do some EDA, First, let's see the amount NA's within the original df, and show what we had to work with.
#that's just a basic one really
#########
# Amount of NA's in each column
# change the full filtered df for a different df if needed
na_summary <- df %>%
summarise(across(everything(), ~ sum(is.na(.)))) %>%
pivot_longer(cols = everything(), names_to = "column_name", values_to = "na_count") %>%
mutate(percent_missing = (na_count / nrow(df)) * 100) %>% ## Watch out for the number of rows
arrange(desc(na_count))
# Print the table
print(na_summary)
#########
# let's have the table be presentable now
owner_summary <- df %>%
# Group by the range column
count(estimated_owners, name = "Count") %>%
# Calculate percentage
mutate(
Percent_Label = percent(Count / sum(Count), accuracy = 0.1)
) %>%
# Sort by Count (or you can sort by the range string if preferred)
arrange(desc(Count))
kable(owner_summary, caption = "Distribution of Estimated Owners")
#glimpse(full_filtered_df) #just asked gpt of a quick way to double check every column is the correct type. well, except release date, mac, windows and linux. everyhting seems fine-ish
full_filtered_df <- full_filtered_df %>%
mutate(
lowest_price_est = as.numeric(str_extract(estimated_owners, "^[0-9]+")),
highiest_price_est = as.numeric(str_extract(estimated_owners, "(?<=-)\\s*[0-9]+")),
est_users = ifelse(lowest_price_est == 0 & highiest_price_est == 0, 100, (lowest_price_est + highiest_price_est) / 2)
)
# testing removing free to play games
full_filtered_df <- full_filtered_df %>%
filter(price != 0)
full_filtered_df <- full_filtered_df %>%
mutate(
price_used   = price, #the reason this is like this, was due to free to play games were given a special price here, i removed that code. but didn't change the rest of the code as they relied on price_used. so i kept it the same
gross_income = est_users * price_used,
log_income   = log1p(gross_income)
)
ggplot(full_filtered_df, aes(x = gross_income)) +
geom_histogram(bins = 10, alpha = 0.7) +
geom_density() +
theme_minimal() +
labs(
title = "Distribution of Gross Income",
x = "Gross Income",
y = "Density"
)
ggplot(full_filtered_df, aes(x = log_income)) +
geom_histogram(bins = 20, alpha = 0.7) +
geom_density() +
theme_minimal() +
labs(
title = "Distribution of Gross Income (logged)",
x = "Logged Gross Income",
y = "Count"
)
# Create a percentile summary table
income_summary <- full_filtered_df %>%
summarise(
n = n(),
Min = min(gross_income, na.rm = TRUE),
Q1 = quantile(gross_income, 0.25, na.rm = TRUE),
Median = median(gross_income, na.rm = TRUE),
Mean = mean(gross_income, na.rm = TRUE),
Q3 = quantile(gross_income, 0.75, na.rm = TRUE),
`95th Pctl` = quantile(gross_income, 0.95, na.rm = TRUE),
`99th Pctl` = quantile(gross_income, 0.99, na.rm = TRUE),
Max = max(gross_income, na.rm = TRUE)
) %>%
# Pivot longer to make it a vertical table (better for reports)
tidyr::pivot_longer(cols = everything(), names_to = "Statistic", values_to = "Value") %>%
mutate(Value_Formatted = if_else(Statistic == "n",
comma(Value),
dollar(Value, scale = 1, suffix = "")))
kable(income_summary, caption = "Summary Statistics for Gross Income")
#Setting up the df of what's actually going to be used. This is really just to save me some time whilst running.
# It's really important that I keep track of which one i'm using
df <- full_filtered_df  #This is the main one, with reduced columns
# If i want to use a different df, i'll have to move this up in the code and re do it
extract_tags_two_stage <- function(tag_string) {
if (is.na(tag_string) || tag_string %in% c("[]", "", "{}")) {
return(character(0))
}
tags <- c()
# Step 1: extract double-quoted tags, and remove them as to not duplicate or make mistakes later
dbl_matches <- str_match_all(tag_string, '"([^"]+)"')[[1]]
if (nrow(dbl_matches) > 0) {
tags <- c(tags, dbl_matches[,2])  # count it
# Remove the matched parts
tag_string <- str_replace_all(tag_string, '"[^"]+"', "")
}
# --- Step 2: extract single-quoted tags like normal
sgl_matches <- str_match_all(tag_string, "'([^']+)'")[[1]]
if (nrow(sgl_matches) > 0) {
tags <- c(tags, sgl_matches[,2])
}
return(unique(tags))
}
all_tags_list <- lapply(df$tags, extract_tags_two_stage)
all_tags <- unique(unlist(all_tags_list))
all_tags <- sort(all_tags)
df <- df %>%
filter(nchar(tags) > 1 ,!is.na(tags), tags != "", tags != "[]")
# this makes the tags into their own columns for later use
df <- df %>%
rowwise() %>%
mutate(cleaned_tags = paste(intersect(all_tags, extract_tags_two_stage(tags)), collapse = ", "))
df_tags <- df %>%
separate_rows(cleaned_tags, sep = ",") %>%
mutate(tag = str_trim(cleaned_tags)) %>%
filter(tag != "") %>%
distinct(name, tag) %>%
mutate(value = 1) %>%
pivot_wider(names_from = tag, values_from = value, values_fill = 0)
df <- df %>%
left_join(df_tags, by = "name")
df <- df %>%
select(-cleaned_tags)
#use colSums on everything except column 1
tag_counts <- colSums(df_tags[, -1])
tag_df <- data.frame(
tag = names(tag_counts),
count = as.numeric(tag_counts)
) %>%
arrange(desc(count)) # highest to lowest
top_tags <- tag_df %>% head(15)
ggplot(top_tags, aes(x = reorder(tag, count), y = count)) +
geom_col(fill = "steelblue") +
coord_flip() + # Makes it easier to read long tag names
labs(title = "Top 15 Most Common Game Tags", x = "Tag", y = "Frequency") +
theme_minimal()
bottom_tags <- tag_df %>% tail(15)
ggplot(bottom_tags, aes(x = reorder(tag, -count), y = count)) +
geom_col(fill = "firebrick") +
coord_flip() +
labs(title = "15 Least Common Game Tags", x = "Tag", y = "Frequency") +
theme_minimal()
#remove the tags that barely appear at all
tags_to_remove <- tag_df %>%
filter(count < 30) %>%
pull(tag)
# for review really
print(tags_to_remove)
ncol(df)
# REMOVE them from your dataframe
df <- df %>%
select(-all_of(tags_to_remove))
# Check how many columns you have left
ncol(df)
ggplot(tag_df, aes(x = count)) +
geom_histogram(binwidth = 5, fill = "grey70", color = "white") +
geom_vline(xintercept = 30, color = "red", linetype = "dashed", size = 1) +
annotate("text", x = 45, y = 5, label = "Cutoff (30)", color = "red") +
labs(title = "Distribution of Tag Frequencies", x = "Number of Occurrences", y = "Number of Tags") +
theme_minimal()
# 1. Identify the tag columns (24th column to the end)
tag_cols <- names(df)[24:ncol(df)]
# 2. Calculate the stats for each tag
# We use sapply to loop through each tag name and calculate the mean price where tag == 1
tag_analysis <- data.frame(
tag = tag_cols,
count = colSums(df[, tag_cols]),
avg_price = sapply(tag_cols, function(t) {
mean(df$price[df[[t]] == 1], na.rm = TRUE)
})
)
# 3. Filter for the Top 20 most frequent tags to keep the plot readable
top_20_tags <- tag_analysis %>%
arrange(desc(count)) %>%
head(20)
top_20_tags_by_money <- tag_analysis %>%
arrange(desc(avg_price)) %>%
head(20)
bottom_20_tags_by_money <- tag_analysis %>%
arrange(avg_price) %>%
head(20)
# 4. Create the plot
ggplot(top_20_tags, aes(x = avg_price, y = reorder(tag, count))) +
geom_col(fill = "darkseagreen", color = "white") +
# Adding the price labels
geom_text(aes(label = paste0("$", round(avg_price, 2))),
hjust = -0.2, size = 3.5, fontface = "bold") +
# Expand x-axis slightly so labels don't get cut off
scale_x_continuous(expand = expansion(mult = c(0, 0.2))) +
theme_minimal() +
labs(
title = "Market Pricing: Average Price of the Most Frequent Tags",
subtitle = "Y-axis sorted by Frequency (Most common tags at top)",
x = "Average Price (USD)",
y = "Game Tag"
)
# Create the High-Price Plot
ggplot(top_20_tags_by_money, aes(x = avg_price,
y = reorder(paste0(tag, " (", count, ")"), avg_price))) +
geom_col(fill = "darkolivegreen", color = "white") +
geom_text(aes(label = paste0("$", round(avg_price, 2))),
hjust = -0.1, size = 3.5, fontface = "bold") +
scale_x_continuous(expand = expansion(mult = c(0, 0.2))) +
theme_minimal() +
labs(
title = "Premium Segments: Tags with Highest Average Price",
subtitle = "Top 20 tags by mean price (USD); counts shown in parentheses",
x = "Average Price",
y = "Game Tag (Count)"
)
# Create the Low-Price Plot
ggplot(bottom_20_tags_by_money, aes(x = avg_price, y = reorder(tag, -avg_price))) +
geom_col(fill = "indianred", color = "white") +
geom_text(aes(label = paste0("$", round(avg_price, 2))),
hjust = -0.1, size = 3.5, fontface = "bold") +
scale_x_continuous(expand = expansion(mult = c(0, 0.2))) +
theme_minimal() +
labs(
title = "Budget Segments: Tags with Lowest Average Price",
subtitle = "Bottom 20 tags by mean price (USD)",
x = "Average Price",
y = "Game Tag"
)
# Bonus first one
ggplot(top_20_tags, aes(x = avg_price, y = reorder(paste0(tag, " (", count, ")"), count))) +
geom_col(fill = "darkseagreen", color = "white") +
geom_text(aes(label = paste0("$", round(avg_price, 2))),
hjust = -0.2, size = 3.5, fontface = "bold") +
scale_x_continuous(expand = expansion(mult = c(0, 0.2))) +
theme_minimal() +
labs(
title = "Market Pricing: Average Price & Frequency of Top Tags",
subtitle = "Y-axis shows tag name and total count (n)",
x = "Average Price (USD)",
y = "Game Tag (Frequency)"
)
ggplot(df, aes(sample = log_income)) +
stat_qq(color = "steelblue", alpha = 0.5) +
stat_qq_line(color = "red", size = 1) +
theme_minimal() +
labs(
title = "Normal Q-Q Plot: Logged Gross Income",
subtitle = "Points following the line indicate data is suitable for Linear Regression",
x = "Theoretical Quantiles",
y = "Sample Quantiles (Logged Income)"
)
# This shouldn't be needed. why is my tagging broken..., i probably overwrote it accidentally somewhere
formula_string <- paste(
"log_income ~",
paste0("`", tag_cols, "`", collapse = " + ")
)
formula <- as.formula(formula_string)
model_income <- lm(formula, data = df)
#diagnostics
par(mfrow = c(1, 2))
plot(model_income)
# Combine into a formal table
formal_results <- data.frame(
Estimate = model_summary$coefficients[,1],
`Std. Error` = model_summary$coefficients[,2],
`Lower 95% CI` = conf_ints[,1],
`Upper 95% CI` = conf_ints[,2],
`p_value` = model_summary$coefficients[,4]
)
knitr::kable(formal_results, digits = 4, caption = "Formal Regression Coefficients and Confidence Intervals")
formal_results
