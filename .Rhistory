# 1. Optimal Box-Cox transformation (stabilizes variance)
lambda <- BoxCox.lambda(ausbeer)
ausbeer_tf <- BoxCox(ausbeer, lambda = lambda)
# 2. First difference of transformed series (detrends/stabilizes mean)
ausbeer_diff <- diff(ausbeer_tf)
# 3. Combine into a single matrix and plot
cbind("1. Raw Series" = ausbeer,
"2. Transformed (Stable Variance)" = ausbeer_tf,
"3. Transformed & Differenced (Stationary Mean)" = ausbeer_diff) %>%
autoplot(facets = TRUE) +
ggtitle("Visual Justification for Transformation & Detrending") +
xlab("Year") +
ylab("")
# ACF of Raw Data (Slow drop = non-stationary trend)
ggAcf(ausbeer) + ggtitle("ACF of Raw Series")
# ACF of Differenced Data (Quick drop = stationary)
ggAcf(ausbeer_diff) + ggtitle("ACF of Transformed & Differenced Series")
